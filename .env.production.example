# Browser
VITE_API_URL=https://api.emadstore.com

# Server-only Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Admin
ADMIN_API_KEY=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# Paymob (server only)
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=REPLACE_ME
PAYMOB_HMAC_SECRET=REPLACE_ME
# Comma-separated Paymob Integration IDs enabled on your account
PAYMOB_INTEGRATION_IDS=123456,123457

# Bosta
BOSTA_API_KEY=REPLACE_ME
BOSTA_BASE_URL=https://app.bosta.co/api/v2

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_VERIFY_TOKEN=REPLACE_ME

PUBLIC_ORIGIN=https://emadstore.com
PORT=8080

# JSON object matching Bosta pickupAddress fields
BOSTA_PICKUP_ADDRESS_JSON={\"firstName\":\"Emad Store\",\"lastName\":\"Warehouse\",\"phone\":\"+20XXXXXXXXXX\",\"addressLine\":\"YOUR_PICKUP_ADDRESS\",\"city\":\"Faiyum\"}

PAYMOB_ONLINE_ENABLED=false
PAYMOB_PUBLIC_KEY=
PAYMOB_NOTIFICATION_URL=https://btjiifbaqjgcbpexkazz.supabase.co/functions/v1/paymob-webhook
PAYMOB_REDIRECTION_URL=https://YOUR_STORE_DOMAIN/payment-result
