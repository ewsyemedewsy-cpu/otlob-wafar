{
  "name": "emad-store",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix apps/web run build",
    "start:api": "npm --prefix services/api start",
    "lint": "npm --prefix apps/web run build",
    "test": "node --test tests/*.test.js",
    "check:edge": "deno check supabase/functions/*/index.ts",
    "test:browser": "node tests/browser.mjs",
    "build": "npm run build:web"
  },
  "workspaces": [
    "apps/web",
    "services/api"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.3",
    "deno": "2.9.6",
    "playwright": "1.63.0"
  }
}